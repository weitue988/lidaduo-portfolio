{
  "name": "lidaduo-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "sync:project-06": "node scripts/sync-project-06-runtime.mjs && node scripts/inject-light-rays-adapter.mjs",
    "build": "vite build && npm run verify",
    "verify": "node scripts/verify-build.mjs",
    "qa:light-rays": "node scripts/verify-light-rays-background.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "package:direct": "npm run build && rm -rf artifacts && mkdir -p artifacts && cd dist && zip -qr ../artifacts/lidaduo-portfolio-direct-upload.zip ."
  },
  "devDependencies": {
    "vite": "7.3.6"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "ogl": "^1.0.11"
  }
}
